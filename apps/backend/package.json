{
  "name": "backend",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --entryFile all.main",
    "build": "prisma generate && nest build",
    "start:api": "node dist/api.main.js",
    "start:worker": "node dist/worker.main.js",
    "start:all": "node dist/all.main.js",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "test": "prisma generate && jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ukr": "^1.0.0",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "ollama": "^0.6.4",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^6.0.1",
    "unpdf": "^1.9.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  }
}
