# --- Database (local docker compose) ---
DATABASE_URL=postgresql://invoices:invoices@localhost:5432/invoices
DIRECT_URL=postgresql://invoices:invoices@localhost:5432/invoices

# --- API ---
PORT=3000
# Optional. When set, every request must send it (header x-access-code); used for the public demo.
ACCESS_CODE=
CORS_ORIGIN=http://localhost:5173

# --- Storage: local | s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible (Supabase Storage / AWS S3), used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI: ollama | gemini | mock ---
LLM_DRIVER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the primary model is overloaded (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# --- Worker ---
WORKER_CONCURRENCY=2
QUEUE_VISIBILITY_TIMEOUT_SECONDS=180
MAX_PROCESSING_ATTEMPTS=3
